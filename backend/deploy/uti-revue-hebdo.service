# Revue hebdomadaire de la plateforme. Déclenchée par uti-revue-hebdo.timer.
#
#   sudo install -m 750 -o julian.talou -g julian.talou \
#        ~/app/backend/deploy/revue_hebdo.sh /usr/local/bin/uti-revue-hebdo
#   sudo cp ~/app/backend/deploy/uti-revue-hebdo.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now uti-revue-hebdo.timer
#   sudo systemctl start uti-revue-hebdo      # première revue, tout de suite
#   journalctl -u uti-revue-hebdo -n 120 --no-pager
[Unit]
Description=Revue hebdomadaire de la plateforme UTI
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Pas de root : la revue LIT (base, disque, journal, conteneur hors-site) et
# n'écrit nulle part. Lui donner root pour lire /etc/uti-backup.env serait un
# marché perdant — et inutile, systemd lit ce fichier AVANT de déposer les
# privilèges (cf. EnvironmentFile ci-dessous).
User=julian.talou
Group=julian.talou
Environment=BACKEND_DIR=/home/julian.talou/app/backend
Environment=BACKUP_DIR=/var/backups/uti
# Doit être identique à LOCAL_STORAGE_DIR de backend/.env : c'est la moitié
# « disque » de la comparaison base↔fichiers. Deux valeurs différentes
# produiraient un rapport qui déclare tous les CV manquants.
Environment=FILES_DIR=/var/lib/uti/files
Environment=PATH=/usr/lib/postgresql/18/bin:/usr/local/bin:/usr/bin:/bin

# ── Secrets du conteneur hors-site ──────────────────────────────────────────
# On réutilise le fichier de la SAUVEGARDE plutôt que d'en recopier les clés :
# deux copies d'un même secret finissent toujours par diverger, et c'est la
# copie oubliée qui reste en place le jour où on croit avoir tourné la clé.
EnvironmentFile=/etc/uti-backup.env

# ⚠️ CETTE LIGNE N'EST PAS DÉCORATIVE.
# /etc/uti-backup.env contient aussi HEALTHCHECK_URL — la sonde DE LA
# SAUVEGARDE. Sans cette neutralisation, une revue verte pingerait la sonde de
# la sauvegarde, et le chien de garde croirait la sauvegarde vivante un
# dimanche où elle serait morte depuis six jours. Un signal qui ment sur ce
# qu'il mesure est pire que pas de signal : c'est précisément la panne que ces
# sondes existent pour détecter. Les directives systemd s'appliquent DANS
# L'ORDRE du fichier : on efface donc après avoir lu, puis on laisse la revue
# poser la sienne si elle en a une.
Environment=HEALTHCHECK_URL=
#   HEALTHCHECK_URL=https://hc-ping.com/<uuid-de-la-sonde-revue-hebdo>
# Fichier FACULTATIF (préfixe « - ») : sans sonde propre, la revue n'en pinge
# aucune — le rapport par e-mail reste, lui, envoyé à chaque exécution.
EnvironmentFile=-/etc/uti-revue-hebdo.env

ExecStart=/usr/local/bin/uti-revue-hebdo
# La revue parcourt tout le disque de fichiers, interroge Backblaze et rejoue
# la suite de tests : quelques minutes en temps normal. 30 min laissent la
# marge, et au-delà quelque chose est bloqué — mieux vaut échouer (donc
# apparaître dans `systemctl list-units --failed`) que rester suspendu.
TimeoutStartSec=1800

# Ce service ÉCHOUE volontairement (exit 1) dès qu'un point est rouge, pour la
# même raison que uti-supervision : l'unité en échec reste visible même si
# l'e-mail n'est jamais parti.
SuccessExitStatus=0

# Durcissement. ProtectHome=false est OBLIGATOIRE : le venv, le .env et les
# tests vivent dans /home. Aucun ReadWritePaths hors de /home n'est nécessaire —
# la revue ne modifie rien ; pytest n'écrit que ses caches, sous /home.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
