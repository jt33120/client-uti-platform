# MIP RUM — réglages de l'agent OpenTelemetry officiel (lu par systemd :
# EnvironmentFile de uti-backend.service). Copier en otel.env, à côté, et remplir
# la clé. otel.env n'est jamais versionné (.gitignore).
#
# Référence : https://mip-rum-console.vercel.app → Installer → Python, et
# https://opentelemetry.io/docs/zero-code/python/
OTEL_SERVICE_NAME=uti-api
# mip.app_id : l'application UTI chez MIP ; mip.api_key : sa clé d'ingestion (la
# même que frontend/public/init-mip-rum.js), exigée par MIP depuis le 29/09/2026.
OTEL_RESOURCE_ATTRIBUTES=mip.app_id=gip-plateforme,mip.api_key=<clé>,deployment.environment.name=production
# Le défaut de l'agent Python est gRPC, que MIP ne reçoit pas : http/protobuf obligatoire.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
# Collecte directe au collector de MIP (06/10/2026), plus par le relais de la console.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector-production-d769.up.railway.app/v1/traces
OTEL_TRACES_EXPORTER=otlp
# Journaux : ceux du module logging (dont les erreurs d'uvicorn, main.py), reliés à
# la requête qui les a produits. Les journaux d'accès d'uvicorn (une ligne par
# requête, avec l'adresse IP) n'en font pas partie.
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://collector-production-d769.up.railway.app/v1/logs
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
# Pas de métriques : MIP n'a pas de route pour elles.
OTEL_METRICS_EXPORTER=none
# Comme l'ancien middleware : pas de span pour les sondes et la documentation.
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health$,/health/db$,/docs$,/openapi.json$,/favicon.ico$
