# ── Base de données ────────────────────────────────────────
# Ces deux variables GARDENT LEUR NOM après la migration vers le VPS :
# supabase-py reste le client, et les 367 appels .table() du backend ne changent
# pas. Seules leurs VALEURS bougent.
#
#   AVANT (Supabase)  SUPABASE_URL=https://<projet>.supabase.co
#                     SUPABASE_SERVICE_KEY=<clé service_role émise par Supabase>
#
#   APRÈS (VPS OVH)   SUPABASE_URL=http://127.0.0.1:8080
#                     SUPABASE_SERVICE_KEY=<JWT HS256 que nous signons>
#
# L'URL d'après est une façade nginx sur la boucle locale, jamais publique : le
# frontend ne parle pas à la base, rien n'oblige à exposer PostgREST. La clé est
# produite par backend/scripts/make_service_key.py, posée par
# backend/deploy/install_db.sh.
#
# Ne PAS mettre de chemin ni de barre oblique finale : supabase-py ajoute
# lui-même « /rest/v1 ».
#
# ⚠️ Ne basculer l'URL qu'une fois l'authentification maison déployée : le
# backend appelle encore /auth/v1/… (routers/auth.py). La façade locale répond
# 501 sur ce chemin, pour que l'oubli se voie tout de suite.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── IA ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_KEY=
# Modèles par usage (OpenRouter). Défauts dans config.py si non renseignés.
# EXTRACTION_MODEL : lecture/normalisation des CV ; SCORING_MODEL : 2e avis IA (score hybride)
# SUMMARY_MODEL : résumé d'AO en 1 phrase ; DRAFT_MODEL : génération de fiche AO
EXTRACTION_MODEL=anthropic/claude-haiku-4.5
SCORING_MODEL=anthropic/claude-haiku-4.5
SUMMARY_MODEL=anthropic/claude-haiku-4.5
DRAFT_MODEL=anthropic/claude-sonnet-4.5
# Assistant intégré : clé OpenRouter dédiée (optionnelle, sinon OPENROUTER_KEY) + modèle
ASSISTANT_OPENROUTER_KEY=
ASSISTANT_MODEL=anthropic/claude-sonnet-4.5
# Supervision IA (onglet Supervision → Usage & coûts IA) : clé de PROVISIONING
# OpenRouter (facultative). Donne accès à l'API compte (/credits, /activity) pour
# un miroir fidèle du dashboard OpenRouter. À défaut, la supervision utilise
# OPENROUTER_KEY (/credits) + le registre interne ai_usage.
OPENROUTER_PROVISIONING_KEY=
# Supervision IA : clés du compte OpenRouter à afficher comme « clés de la
# plateforme » (les autres apps du compte sont masquées). Noms ou fragments,
# séparés par des virgules. Vide = préfixe « plateforme » par défaut.
OPENROUTER_SUPERVISED_KEYS=
# Fallback LLM si OpenRouter indisponible (ex. solde vide) — clé Mistral La Plateforme
MISTRAL_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Environnement ──────────────────────────────────────────
# "production" (défaut, durci : /docs coupé, HSTS, garde JWT) ou "dev"/"local"
APP_ENV=production

# ── Auth ───────────────────────────────────────────────────
# OBLIGATOIRE en prod : sans secret fort le backend REFUSE de démarrer.
#   JWT_SECRET=$(openssl rand -hex 32)
#
# ⚠️ CE SECRET DOIT DIFFÉRER DE CELUI DE POSTGREST (/etc/postgrest/jwt.secret).
# create_token() place déjà une revendication `role` dans le jeton de session de
# chaque utilisateur. Avec un secret commun, ce jeton serait une clé PostgREST
# valide : tout navigateur connecté détiendrait un accès direct à la base.
# Aujourd'hui un tel jeton donne « role admin does not exist » — le jour où un
# rôle SQL portera ce nom, ce sera un accès SQL, pas une erreur.
JWT_SECRET=change-me-in-production
FRONTEND_URL=https://git-alpha-hazel.vercel.app

# ── Email : SMTP Infomaniak (envoi transactionnel) ─────────
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=plateforme.grp-it@hbccp.fr
SMTP_PASSWORD=
SMTP_FROM=plateforme.grp-it@hbccp.fr
SMTP_FROM_NAME=UTI Group
# Destinataire pour scripts/test_smtp.py uniquement
SMTP_TEST_TO=

# Destinataire des notifications de support / contact
ADMIN_EMAIL=

# ── Stockage des fichiers (CV / avatars / pièces d'AO / conformité) ────────
# "supabase" (défaut) | "s3" (OVH Object Storage) | "local" (disque du VPS)
# ⚠️ Une valeur inconnue fait REFUSER LE DÉMARRAGE (config.py). Avant, elle
# retombait en silence sur Supabase — c'est-à-dire sur le projet qu'on supprime.
STORAGE_BACKEND=supabase

# ── Mode "local" : les fichiers vivent sur le disque du VPS ────────────────
# Racine du dépôt. HORS de ~/app (deploy.sh remplace cet arbre) et hors de /home
# (la FHS place l'état applicatif persistant dans /var/lib, et c'est ce que la
# sauvegarde vise). Droits attendus : 0700, propriétaire julian.talou.
#   sudo install -d -m 750 -o julian.talou -g julian.talou /var/lib/uti
#   sudo install -d -m 700 -o julian.talou -g julian.talou /var/lib/uti/files
LOCAL_STORAGE_DIR=/var/lib/uti/files
# OBLIGATOIRE si STORAGE_BACKEND=local : origine HTTPS publique du BACKEND
# (la façade nginx), pas celle du frontend. Les URLs de fichiers sont ouvertes
# depuis Vercel et depuis des clients de messagerie ; une URL relative n'y veut
# rien dire. Sans elle, le backend refuse de démarrer.
PUBLIC_BASE_URL=https://vps-cc93f2a8.vps.ovh.net
# Facultatif. Vide = clé dérivée de JWT_SECRET par HMAC (séparation de domaine
# assurée, rien à gérer de plus). Le renseigner permet d'invalider d'un coup
# toutes les URLs de fichiers déjà émises SANS déconnecter les utilisateurs :
#   FILE_URL_SECRET=$(openssl rand -hex 32)
# ⚠️ Ne JAMAIS y remettre la valeur de JWT_SECRET : un jeton de session et un
# jeton d'URL n'ont pas la même exposition — celui-ci voyage dans l'URL, donc
# dans les journaux nginx, l'historique du navigateur et la boîte mail du client
# qui reçoit un CV.
FILE_URL_SECRET=

# ── Mode "s3" : renseigner ci-dessous UNIQUEMENT si STORAGE_BACKEND=s3 ─────
S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=uti-files
# Base URL publique des objets (souvent endpoint + nom du bucket)
S3_PUBLIC_BASE_URL=https://uti-files.s3.gra.io.cloud.ovh.net

# ── MIP RUM — tracing distribué (optionnel ; vide = middleware inactif) ────
# Endpoint d'ingestion MIP RUM et identifiant d'app (cf. console MIP RUM)
MIP_RUM_ENDPOINT=
MIP_RUM_APP_ID=
# Clé d'API de l'app (laisser vide si l'app n'a pas de clé)
MIP_RUM_API_KEY=
# ── xSOM AI Guard — dual-emit des spans gen_ai (observabilité IA) ──────────
# Les mêmes spans gen_ai partent aussi vers xSOM (en plus de MIP RUM). Base
# incluant /v1 + un gateway token xSOM (xsg_…). Vide = aucun envoi xSOM.
XSOM_AI_URL=
XSOM_GATEWAY_TOKEN=
# API de LECTURE MIP RUM (onglet Supervision → RUM). Le backend UTI proxifie
# cette API propriétaire avec un token d'accès (gardé côté serveur). Laisser
# vide tant que MIP RUM n'expose pas encore son API de lecture.
MIP_RUM_READ_URL=
MIP_RUM_READ_TOKEN=
